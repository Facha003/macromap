# ── Copy to .env.local. Everything is optional: with no values the app runs
#    locally with an embedded Postgres, OpenStreetMap and template estimates.

# Contact for OpenStreetMap services (Overpass/Nominatim usage policy requires it)
CONTACT_EMAIL=

# Time zone used for "today" on the server
APP_TIMEZONE=Europe/Oslo

# ── AI ingredient interpretation (free options first) ──────────────────────
# Picks the first provider with credentials unless LLM_PROVIDER is set
# (gemini | groq | ollama | anthropic | none).
LLM_PROVIDER=
# Google Gemini — free tier, key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq — free tier, key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama — fully local and free, e.g. http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# Anthropic Claude — paid, optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Server-wide cap on AI calls (keep under your free-tier limit)
AI_REQUESTS_PER_MINUTE=10

# ── Places ──────────────────────────────────────────────────────────────────
# Default: OpenStreetMap via Overpass (free). Comma-separated fallbacks allowed.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Optional Google Places (New) — billed; used instead of OSM when set
GOOGLE_PLACES_API_KEY=
# Force OSM even if a Google key exists: PLACES_PROVIDER=osm
PLACES_PROVIDER=

# ── Food-composition seed (npm run seed:foods) ─────────────────────────────
# USDA FoodData Central key (free at https://fdc.nal.usda.gov/api-key-signup); DEMO_KEY works for small runs
USDA_FDC_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Empty → embedded Postgres (PGlite) in .data/pglite
# Supabase: Project Settings → Database → Connection string (transaction pooler, port 6543)
DATABASE_URL=
PGLITE_DIR=

# ── Supabase Auth (optional magic-link accounts) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin import of official restaurant nutrition ──────────────────────────
ADMIN_TOKEN=
